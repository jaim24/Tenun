# --- Tenun · environment ---
# Salin file ini menjadi .env lalu isi.

# Basis data (PostgreSQL). Lokal & Vercel memakai URL yang sama, mis. dari Neon/Vercel Postgres:
# DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/tenun?sslmode=require"
DATABASE_URL="postgresql://user:pass@localhost:5432/tenun"

# Sesi admin. WAJIB set minimal 32 karakter acak.
AUTH_SECRET="ganti-dengan-string-acak-panjang-32-karakter"
# Admin login (halaman masuk workspace).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti-sandikuat"

# URL aplikasi (tanpa garis miring di akhir).
APP_URL="http://localhost:3000"

# --- Meta / Threads OAuth ---
# Ambil di developers.facebook.com → Apps → (appmu) → App settings → Basic
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
# Harus SAMA persis dengan Redirect URI yang didaftarkan.
THREADS_REDIRECT_URI="http://localhost:3000/api/threads/callback"
# Scope default bila tidak diisi.
THREADS_OAUTH_SCOPES="threads_basic threads_content_publish threads_manage_replies threads_read_replies threads_manage_mentions threads_keyword_search threads_manage_insights"

# --- Cron / scheduler ---
# Nilai ini wajib dikirim sebagai header `x-cron-secret` (atau ?token=) oleh scheduler.
CRON_SECRET="dev-cron-secret"

# --- Opsional: Vercel Blob untuk upload gambar (di Vercel ada otomatis) ---
# BLOB_READ_WRITE_TOKEN=""